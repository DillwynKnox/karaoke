# Image Woodpecker pushes: <registry_url>/<registry_image_karaoke_guest>:latest
GUEST_IMAGE=registry.example.com/karaoke-guest:latest

# --- Tailscale sidecar ---
# Auth key from https://login.tailscale.com/admin/settings/keys (reusable + ephemeral is fine).
TS_AUTHKEY=tskey-auth-...
TS_HOSTNAME=karaoke-guest

# --- Reverse proxy in front of this container ---
# Port on 127.0.0.1 of the VPS that your nginx/Caddy/Traefik forwards to.
BIND_PORT=8082

# --- The hub ---
# Tailscale name or IP of the PC that runs the karaoke, and the shared secret it expects.
HUB_HOST=brick
HUB_TOKEN=

# --- Guest access ---
# The player shows a QR code with https://<your-domain>/k/<code>, where the code is derived
# from this secret and changes every GUEST_CODE_MINUTES (0 = never). Put the same two values
# in the .env of the laptop. Only entering needs a current code; who scanned once stays in
# through the cookie. openssl rand -hex 32
GUEST_INVITE_SECRET=
GUEST_CODE_MINUTES=10
# Optional fixed code for a printed link: https://<your-domain>/k/<GUEST_ACCESS_CODE>
GUEST_ACCESS_CODE=
# Any long random string; changing it signs every guest out. openssl rand -hex 32
GUEST_COOKIE_SECRET=
# How long a guest stays in after scanning once.
GUEST_COOKIE_DAYS=1

# --- Limits ---
# Songs a single guest may have waiting in the queue at the same time.
GUEST_MAX_OPEN=10
GUEST_ADD_PER_MIN=5
GUEST_ADD_PER_HOUR=40
GUEST_SEARCH_PER_MIN=30
GUEST_STATE_PER_MIN=120
# Number of reverse proxies in front of this container, for a trustworthy client IP.
GUEST_PROXY_HOPS=1
