# ---------------------------------------------------------------------------
# Role of this machine, used when `uv run karaoke` is started without a command.
#
#   hub     (default) compute, queue and storage; also serves admin, player and guest UI
#   player  laptop at the screen: admin and player UI with a local cache of the queue
#   guest   the public page where everybody can add songs (see deploy/vps/)
# ---------------------------------------------------------------------------
ROLE=hub

# Where songs, stems, lyrics and the queue are kept (default: storage/ in the project).
KARAOKE_STORAGE=

# HTTP_HOST=0.0.0.0 makes the UIs reachable from other devices. On the hub of a split
# setup, the Tailscale address of this machine is the tighter choice.
HTTP_HOST=
ADMIN_PORT=8080
PLAYER_PORT=8081
GUEST_PORT=8082

# --- Split setup: hub (this PC) ---

# Shared secret the player and guest node have to send. Requests from this machine itself
# never need it. Leave empty to accept anything that reaches the ports.
HUB_TOKEN=
# Public address of the guest page, e.g. https://karaoke.example.com. The player shows it as
# a QR code (the admin UI under "Invite QR"). With GUEST_INVITE_SECRET the rotating
# /k/<code> is appended; without it, put the full invite link here.
PUBLIC_GUEST_URL=

# --- Split setup: player node (the laptop) ---

# Tailscale name or IP of the hub, e.g. brick.
HUB_HOST=
HUB_ADMIN_PORT=8080
HUB_PLAYER_PORT=8081
HUB_GUEST_PORT=8082
HUB_TIMEOUT=5
# PUBLIC_GUEST_URL, GUEST_INVITE_SECRET and GUEST_CODE_MINUTES go on the machine whose
# player shows the QR - in the split setup this one.
# Where the prefetched songs land, and how many queued songs are pulled ahead of time.
CACHE_DIR=
PREFETCH_COUNT=3
CACHE_MAX_GB=20

# --- Split setup: guest node (the VPS) ---
# The full list with its limits lives in deploy/vps/.env.example.
# Same value here and on the guest node: the QR code on the player carries an invite code
# derived from it that changes every GUEST_CODE_MINUTES (0 = never). Only entering needs a
# current code; who scanned once stays in through the cookie. openssl rand -hex 32
GUEST_INVITE_SECRET=
GUEST_CODE_MINUTES=10
# Optional fixed code for a printed invite link (/k/<code>).
GUEST_ACCESS_CODE=
GUEST_COOKIE_SECRET=
GUEST_MAX_OPEN=10

# --- Hub: audio processing ---

# Force the torch device (cpu | cuda | mps). Empty = auto-detect; ROCm GPUs show up as cuda.
DEMUCS_DEVICE=

# Word-level lyrics alignment (1 = on, 0 = only line-synced lyrics from LRCLIB)
LYRICS_ALIGN=1
